{
  "cleanUrls": false,
  "rewrites": [{ "source": "/((?!assets/|ocr/|favicon\\.svg).*)", "destination": "/index.html" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/ocr/(.*)\\.gz", "headers": [{ "key": "Content-Type", "value": "application/gzip" }] }
  ]
}
